# URL base de la API del servidor.
VITE_API_URL=http://localhost:5000/api

# api (por defecto): usa el backend real con Axios.
#   GET /api/menu, GET /api/store/status, GET /api/orders/wait-time,
#   POST /api/auth/register y POST /api/orders.
# mock: usa client/src/data sin backend ni MongoDB.
VITE_DATA_SOURCE=api
